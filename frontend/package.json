{
  "name": "gastroflowx-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev:extension": "vite --config vite.config.js",
    "build:extension": "vite build --config vite.config.js",
    "zip:extension": "vite build --config vite.config.js && node scripts/zip-extension.mjs",
    "dev:admin": "vite --config vite.admin.config.js",
    "build:admin": "vite build --config vite.admin.config.js",
    "build": "npm run build:extension && npm run build:admin",
    "test": "vitest run"
  },
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "^7.3.1",
    "@fortawesome/free-regular-svg-icons": "^7.3.1",
    "@fortawesome/free-solid-svg-icons": "^7.3.1",
    "@fortawesome/vue-fontawesome": "^3.3.3",
    "@inboxsdk/core": "^2.2.27",
    "axios": "^1.20.0",
    "pinia": "^3.0.4",
    "vue": "^3.5.43",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^3.0.0",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vue/test-utils": "^2.5.1",
    "autoprefixer": "^10.6.1",
    "happy-dom": "^20.14.5",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.19",
    "vite": "^7.3.6",
    "vitest": "^5.0.3"
  },
  "description": "GastroFlowx frontends: Gmail extension (CRM for staff) and Master Admin web panel"
}
