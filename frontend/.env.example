# Laravel API base URL (must include the /api prefix). Used by both apps;
# for the extension its origin is also added to the manifest's host_permissions.
VITE_API_BASE_URL=http://localhost:8000/api

# Gmail extension only: free app id from https://www.inboxsdk.com/register (required by InboxSDK.load).
VITE_INBOXSDK_APP_ID=

# Optional: Google integration (import of past Gmail correspondence + Google Calendar sync).
# Google Cloud console → APIs: enable "Gmail API" and "Google Calendar API" →
# Google Auth Platform → Clients → type "Web application" with the authorized redirect URI
# https://<extension-id>.chromiumapp.org/  (the extension signs in with the Gmail tab's account).
VITE_GOOGLE_OAUTH_CLIENT_ID=

# Optional: manifest "key" (base64 public key) so a locally loaded build has the same ID as the store one.
# Get it from the Chrome Web Store dashboard (Package → View public key) or generate one with openssl.
# npm run zip:extension strips it from the store package (the Web Store rejects "key").
VITE_EXTENSION_KEY=
